# Neon PostgreSQL connection string (server-side only)
DATABASE_URL=

# Application
NEXT_PUBLIC_APP_NAME=صيدليتي
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional dedicated secret for pseudonymous admin login rate-limit fingerprints
AUTH_RATE_LIMIT_SECRET=generate-a-long-random-secret

# Cloudinary product image storage (server-side secrets; never expose with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial admin bootstrap (used only by npm run admin:create)
ADMIN_NAME="مدير صيدليتي"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
